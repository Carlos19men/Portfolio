---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';
import Ovalo from '../components/Ovalo.astro';
import Title from '../components/Title.astro';
import Card from '../components/Card.astro';
import Proyects from '../components/Proyects.astro';
// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build

---

<Layout>
	{/* óvalos*/ }
	<Ovalo width={444} height={256} color="#04243C" left={-17} top={15} zIndex={0} rotation={45}/>
	<div class="relative ml-20 mt-28 w-[90%] h-[400px] inline-flex rounded-">
		<p class=" w-3xl text-4xl text-white pt-20 pt">
			Más allá del diseño y la estrategia, mi verdadero objetivo es 
			impulsar el crecimiento y la conexión a través de experiencias 
			significativas <br /><br />
	 
			¿Quieres descubrir cómo?	
		</p>
		<Ovalo width={484} height={169} color="#323A3C" left={120} top={8} zIndex={0} rotation={-37} />
		<Ovalo width={481} height={233} color="#04293B" left={110} top={4} zIndex={0} rotation={57} opaciti={0.5}/>
		
		<div class="relative left-[80px]">
			<img class=" w-90 right-[15vw] object-contain" src="/images/mental-model.png" alt="Astro Logo" />
		</div>	
		
	</div>

	{/* Proyectos */ }
	<div class="flex justify-center mt-20">
		<Ovalo width={681} height={463} color="#04293B" top={50}  opaciti={0.4}/>

		<Title title="Proyectos" />

		
	</div>

	<div class="flex justify-center mt-5 h-[600px]">

		<Card title="PymeUp" 
			description="Una plataforma web dirigida a las pequeñas y medianas empresas de ciudad Guayana, destinada a organizar y aumentar las ventas de tu negocio" 
			img="project1.png" 
			href='#'
			isPrincipal/>
		
		
	</div>

	<div>
		{
			/*aquí aplica un ciclo repetitivo considerando que los  otros proyectos 
			se agrupan en pareja, la primera pareja se muestra del lado izquierdo de la pantalla
			y la segunda del lado derecho, esto se repite cada dos parejas, el ciclo termina cuando 
			aparezca un proyecto solo o siemplemente cuando no halla más parejas. 
			*/

			//primero armamos la forma base 


		}

		<Proyects proyects={[]}/>

	</div>

	<div class="h-[500px]">
		a
	</div>

	

	
	

</Layout>

<style>
	p{
    	font-family: 'Jersey 25', system-ui;
	}
</style>
